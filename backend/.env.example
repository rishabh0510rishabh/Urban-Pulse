# Server Configuration
PORT=5000
NODE_ENV=development
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here

# Database Connection (MongoDB Atlas)
DB_URI=mongodb+srv://<username>:<password>@cluster0.aurfae6.mongodb.net/urbanpulse?retryWrites=true&w=majority
CLOUD_DB_URI=mongodb+srv://<username>:<password>@cluster0.aurfae6.mongodb.net/urbanpulse?retryWrites=true&w=majority

# CORS / Frontend Links
DEV_LINK_REACT=http://localhost:3000
PROD_LINK_REACT=https://your-production-domain.com

# Cloudinary (Optional - for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Nodemailer / OTP (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
OTP_MAIL=your_otp_email@gmail.com
OTP_PASS=your_otp_app_password

# Mapbox (Optional - for geocoding)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Twilio (Optional - for SMS alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Razorpay (Optional - for payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
